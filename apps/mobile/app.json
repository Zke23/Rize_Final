{
  "expo": {
    "name": "Matroom",
    "slug": "matroom",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-secure-store",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Matroom to choose wrestling videos from your library."
        }
      ]
    ]
  }
}
